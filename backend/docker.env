# This file contains environment variables for the Docker containers.
# It's referenced by docker-compose.yml.

# --- PostgreSQL Database Configuration ---
# These variables are used by the 'db' service in docker-compose.yml
# and to construct the DATABASE_URL if it's not provided directly.
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# --- Application Settings ---
PROJECT_NAME="ivanintech"
# This is a critical security setting. Use a long, random string.
# You can generate one with: openssl rand -hex 32
SECRET_KEY=09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7

# --- Superuser Creation ---
# These credentials will be used to create the first admin user.
FIRST_SUPERUSER=admin@ivanintech.com
FIRST_SUPERUSER_PASSWORD=Adidas93#@

# --- Supabase Configuration (if you use it) ---
# If you are using Supabase, uncomment DATABASE_URL and fill it with your connection string.
# The format is: postgresql+asyncpg://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres
# DATABASE_URL=
SUPABASE_URL=https://your_supabase_url.supabase.co
SUPABASE_SERVICE_KEY=your_service_key

# --- Email Configuration (using Mailcatcher for local development) ---
MAIL_SERVER=mailcatcher
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=info.ivanintech@gmail.com
MAIL_FROM_NAME="Ivan In Tech"
MAIL_STARTTLS=False
MAIL_SSL_TLS=False
USE_CREDENTIALS=False
VALIDATE_CERTS=False

# --- API Keys (Optional - for news fetching, etc.) ---
GEMINI_API_KEY=
NEWSAPI_API_KEY=
GITHUB_TOKEN=

# --- CORS Origins ---
# A comma-separated list of URLs that are allowed to connect to the backend.
# The frontend URL is added automatically.
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:8000,https://ivanintech.com"

# --- Additional Configuration ---
ENVIRONMENT=local
API_V1_STR=/api/v1
STACK_NAME=full-stack-fastapi-project
FRONTEND_HOST="http://localhost:8000"
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000/api/v1"
SQLALCHEMY_DATABASE_URI="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}" 